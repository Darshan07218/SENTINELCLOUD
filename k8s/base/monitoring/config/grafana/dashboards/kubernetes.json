        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(kube_pod_status_phase{namespace=\"sentinelcloud\", phase=\"Running\"})",
          "refId": "A",
          "legendFormat": "__auto",
