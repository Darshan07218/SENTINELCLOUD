    {
      "type": "heatmap",
      "title": "Latency distribution (heatmap)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Each column is a time slice; darker cells = more requests in that latency bucket.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (le) (increase(http_server_requests_seconds_bucket{job=\"$service\", uri!~\"/health.*|/metrics|/prometheus|/info|/actuator.*\"}[$__rate_interval]))",
          "refId": "A",
          "legendFormat": "{{le}}",
          "range": true,
          "instant": false,
          "format": "heatmap"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "scaleDistribution": {
              "type": "linear"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "calculate": false,
        "yAxis": {
          "axisPlacement": "left",
          "unit": "s"
        },
        "cellGap": 2,
        "color": {
          "mode": "scheme",
          "scheme": "Blues",
          "steps": 64,
          "fill": "dark-blue",
          "scale": "exponential",
          "exponent": 0.5,
          "reverse": false
        },
        "rowsFrame": {
          "layout": "auto"
        },
        "tooltip": {
          "mode": "single",
          "yHistogram": true
        },
        "legend": {
          "show": true
        },
        "exemplars": {
