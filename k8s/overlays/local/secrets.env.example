# =========================================================================
# SentinelCloud — Kubernetes Secret source, LOCAL overlay.
#
# Phase 12: don't fill this in by hand. Generate secrets.env (gitignored)
# with random values:
#   ./scripts/generate-secrets.sh k8s          (Linux / macOS / Git Bash / WSL)
#   .\scripts\generate-secrets.ps1 k8s         (Windows PowerShell)
# Re-running it keeps every value that is already a real secret and only
# replaces missing or placeholder ones, so it's also the upgrade path from
# earlier phases.
#
# Every service refuses to start if a secret below is missing, too short,
# or still "CHANGE_ME" (see SECURITY.md).
#
# k8s/overlays/local/kustomization.yaml turns secrets.env into the Secret
# "sentinelcloud-secrets-<hash>". The hash changes whenever a value
# changes and Kustomize rewrites every reference to it, so re-running
# `kubectl apply -k k8s/overlays/local` rolls every pod that uses it.
# =========================================================================

# Postgres superuser: used ONLY by the Postgres container's init script.
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=CHANGE_ME

# One database user per service (least privilege). The user names are
# fixed in the manifests (auth_svc, hospital_svc, …); only passwords here.
AUTH_DB_PASSWORD=CHANGE_ME
HOSPITAL_DB_PASSWORD=CHANGE_ME
AMBULANCE_DB_PASSWORD=CHANGE_ME
BLOOD_BANK_DB_PASSWORD=CHANGE_ME
POWER_DB_PASSWORD=CHANGE_ME
DISASTER_DB_PASSWORD=CHANGE_ME
RESPONSE_DB_PASSWORD=CHANGE_ME

# RabbitMQ (services build amqp://user:password@rabbitmq:5672 from these,
# so the generator only uses URL-safe characters).
RABBITMQ_USER=sentinel
RABBITMQ_PASSWORD=CHANGE_ME

# Redis (requirepass).
REDIS_PASSWORD=CHANGE_ME

# JWT signing keys (>= 32 chars, must differ). The access secret is shared
# by every service that verifies tokens; the refresh secret only by auth-service.
JWT_ACCESS_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME

# Bootstrap SYSTEM_ADMIN (created once, if no admin exists). The generator
# prints the password once; it must satisfy the password policy.
DEFAULT_ADMIN_EMAIL=admin@sentinelcloud.local
DEFAULT_ADMIN_PASSWORD=CHANGE_ME
# Phase 16: service account simulator-service logs in with (SYSTEM_ADMIN;
# reset from these values on every auth-service start). Never a person's login.
SIMULATOR_EMAIL=simulator@sentinelcloud.local
SIMULATOR_PASSWORD=CHANGE_ME

# Grafana admin login (http://localhost:30030).
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME

# Phase 11: token for Resilience Demo fault injection. Only resilience-service
# and the four drill targets receive it; /internal/* refuses any request
# without it (and the gateway never proxies /internal).
RESILIENCE_CHAOS_TOKEN=CHANGE_ME
