# =========================================================================
# SentinelCloud — root environment file for Docker Compose.
#
# Phase 12: don't copy this by hand. Generate .env (gitignored) with
# random secrets:
#   ./scripts/generate-secrets.sh compose        (Linux / macOS / Git Bash / WSL)
#   .\scripts\generate-secrets.ps1 compose       (Windows PowerShell)
# It copies this file and replaces every CHANGE_ME with a random value.
# Re-running it keeps values that are already real secrets, so it is also
# the upgrade path from earlier phases.
#
# docker compose refuses to start if a required secret is missing, and
# every service refuses to start if one is short or still CHANGE_ME
# (see SECURITY.md).
# =========================================================================

# ---- Network exposure ----
# Published ports listen on this address. 127.0.0.1 = this computer only.
# 0.0.0.0 = everyone who can reach this machine (demo from another device).
BIND_ADDRESS=127.0.0.1

# ---- Postgres ----
# Superuser: used only by the init script that creates the per-service users.
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=CHANGE_ME
# One database user per service (users auth_svc, hospital_svc, …, are
# fixed in docker-compose.yml); passwords:
AUTH_DB_PASSWORD=CHANGE_ME
HOSPITAL_DB_PASSWORD=CHANGE_ME
AMBULANCE_DB_PASSWORD=CHANGE_ME
BLOOD_BANK_DB_PASSWORD=CHANGE_ME
POWER_DB_PASSWORD=CHANGE_ME
DISASTER_DB_PASSWORD=CHANGE_ME
RESPONSE_DB_PASSWORD=CHANGE_ME

# ---- Redis (password required) ----
REDIS_PASSWORD=CHANGE_ME

# ---- RabbitMQ ----
# docker-compose.yml builds amqp://user:password@rabbitmq:5672 from these,
# so the generator uses URL-safe characters only.
RABBITMQ_DEFAULT_USER=sentinel
RABBITMQ_DEFAULT_PASS=CHANGE_ME

# ---- JWT ----
# At least 32 characters each, and different. The access secret is shared by
# every service that verifies tokens; the refresh secret only by auth-service.
JWT_ACCESS_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# bcrypt cost factor (minimum 12; lower values are ignored).
BCRYPT_SALT_ROUNDS=12

# Bootstrap SYSTEM_ADMIN, seeded once by auth-service if no SYSTEM_ADMIN
# exists yet (sign-up only ever creates CITIZEN accounts). The generator
# creates a random password that satisfies the password policy and stores it here.
DEFAULT_ADMIN_EMAIL=admin@sentinelcloud.local
DEFAULT_ADMIN_PASSWORD=CHANGE_ME
# Phase 16: service account simulator-service logs in with (SYSTEM_ADMIN;
# reset from these values on every auth-service start). Never a person's login.
SIMULATOR_EMAIL=simulator@sentinelcloud.local
SIMULATOR_PASSWORD=CHANGE_ME
DEFAULT_ADMIN_NAME=SentinelCloud System Administrator

# ---- Host ports (docker-compose.yml) ----
# Only the gateway and the frontend are published; the application services
# are reachable only through the gateway (Phase 12).
GATEWAY_PORT=8080
FRONTEND_PORT=5173

# ---- Gateway rate limits (per minute) ----
RATE_LIMIT_API_PER_MINUTE=600
RATE_LIMIT_WRITES_PER_MINUTE=60

# ---- Frontend ----
# docker-compose.yml builds the frontend's VITE_API_BASE_URL from
# GATEWAY_PORT, so nothing else is needed here.
# Basemap tiles for the live maps. Since Aug 2026 CARTO watermarks keyless
# tiles ("API KEY REQUIRED"). Free key: https://carto.com/basemaps/apikey
# It is sent from the browser by design — restrict it to your domains in CARTO.
CARTO_BASEMAP_KEY=

# ---- Monitoring ----
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
