# Phase 12: placeholders only. Copy the real values from the root .env
# (created by scripts/generate-secrets.sh). The service refuses to start
# while a secret is missing, short or CHANGE_ME.
PORT=8082
DB_HOST=localhost
DB_PORT=5432
DB_USER=hospital_svc
DB_PASSWORD=CHANGE_ME
DB_NAME=hospital_db
RABBITMQ_URL=amqp://sentinel:CHANGE_ME@localhost:5672
JWT_ACCESS_SECRET=CHANGE_ME
# Max Postgres connections per replica (keep the sum over all services < max_connections)
DB_POOL_MAX=5
