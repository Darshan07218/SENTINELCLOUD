# Phase 12: placeholders only. Copy the real values from the root .env
# (created by scripts/generate-secrets.sh). The service refuses to start
# while a secret is missing, short or CHANGE_ME.
PORT=8080
RABBITMQ_URL=amqp://sentinel:CHANGE_ME@localhost:5672

AUTH_SERVICE_URL=http://localhost:8081
HOSPITAL_SERVICE_URL=http://localhost:8082
AMBULANCE_SERVICE_URL=http://localhost:8083
BLOOD_BANK_SERVICE_URL=http://localhost:8084
POWER_SERVICE_URL=http://localhost:8085
DISASTER_SERVICE_URL=http://localhost:8086
NOTIFICATION_SERVICE_WS_URL=ws://localhost:8087
NOTIFICATION_SERVICE_URL=http://localhost:8087
RESILIENCE_SERVICE_URL=http://localhost:8088
RESPONSE_SERVICE_URL=http://localhost:8089
SIMULATOR_SERVICE_URL=http://localhost:8090

# Must equal auth-service's JWT_ACCESS_SECRET (the gateway verifies tokens).
JWT_ACCESS_SECRET=CHANGE_ME
# Browser origins allowed by CORS and the WebSocket origin check (comma-separated).
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Reverse proxies in front of the gateway whose X-Forwarded-For is trusted
# (0 when the browser talks to the gateway directly, 1 behind nginx in Kubernetes).
TRUST_PROXY_HOPS=0
RATE_LIMIT_API_PER_MINUTE=600
RATE_LIMIT_WRITES_PER_MINUTE=60
RATE_LIMIT_WS_PER_MINUTE=30
