# Phase 19: placeholders only. Copy the real values from the root .env
# (created by scripts/generate-secrets.sh). The service refuses to start
# while a secret is missing, short or CHANGE_ME.
PORT=8091
DB_HOST=localhost
DB_PORT=5432
DB_USER=intake_svc
DB_PASSWORD=CHANGE_ME
DB_NAME=intake_db
JWT_ACCESS_SECRET=CHANGE_ME
# Service account it creates disasters with (role EMERGENCY_OPERATOR, seeded by auth-service).
GATEWAY_URL=http://localhost:8080/api/v1
INTAKE_EMAIL=intake@sentinelcloud.local
INTAKE_PASSWORD=CHANGE_ME
# Watched area (default: Pune) and what counts.
WATCH_NAME=Pune
WATCH_LATITUDE=18.5204
WATCH_LONGITUDE=73.8567
WATCH_RADIUS_KM=500
WATCH_MIN_MAGNITUDE=3.0
# LOW | MEDIUM | HIGH | CRITICAL | NONE: detections at or above it become disasters without a person.
AUTO_CONFIRM_MIN_SEVERITY=CRITICAL
# usgs,open-meteo (default), a subset, or none.
INTAKE_SOURCES=usgs,open-meteo
