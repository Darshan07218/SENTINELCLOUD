# Phase 12: placeholders only. Copy the real values from the root .env
# (created by scripts/generate-secrets.sh). The service refuses to start
# while a secret is missing, short or CHANGE_ME.
PORT=8081
DB_HOST=localhost
DB_PORT=5432
DB_USER=auth_svc
DB_PASSWORD=CHANGE_ME
DB_NAME=auth_db

JWT_ACCESS_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

BCRYPT_SALT_ROUNDS=12

# Bootstrap SYSTEM_ADMIN account, seeded once if no SYSTEM_ADMIN exists yet.
# Change the password immediately after first login in any non-throwaway environment.
DEFAULT_ADMIN_EMAIL=admin@sentinelcloud.local
DEFAULT_ADMIN_PASSWORD=CHANGE_ME
DEFAULT_ADMIN_NAME=SentinelCloud System Administrator
# Max Postgres connections per replica (keep the sum over all services < max_connections)
DB_POOL_MAX=5

# Refresh-token cookie. COOKIE_SECURE=false only for plain-http local dev
# (Compose sets it); keep the default (Secure) anywhere served over HTTPS.
COOKIE_SECURE=false
REFRESH_COOKIE_PATH=/api/v1/auth
# Proxies in front of auth-service whose X-Forwarded-For is trusted (the gateway = 1).
TRUST_PROXY_HOPS=1
