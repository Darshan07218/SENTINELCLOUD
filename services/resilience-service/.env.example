# Phase 12: placeholders only. Copy the real values from the root .env
# (created by scripts/generate-secrets.sh). The service refuses to start
# while a secret is missing, short or CHANGE_ME.
# resilience-service (Phase 11) — only meaningful inside Kubernetes
# (it uses the pod's ServiceAccount to talk to the Kubernetes API).
PORT=8088
POD_NAMESPACE=sentinelcloud
JWT_ACCESS_SECRET=CHANGE_ME
CHAOS_TOKEN=CHANGE_ME
RABBITMQ_MGMT_URL=http://rabbitmq:15672
RABBITMQ_USER=sentinel
RABBITMQ_PASSWORD=CHANGE_ME
# Replicas used for pod-failure drills (one fails, the rest keep serving)
DRILL_REPLICAS=2
