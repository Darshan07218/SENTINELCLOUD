{
  "description": "Historical Indian disasters used to validate the casualty model (docs/PHASE-22-VALIDATION.md). Inputs (type, severity, radius) follow the fixed rules in 'rules', never the outcome. Observed figures are publicly reported, approximate, and rounded; sources are the linked articles and the reports they cite.",
  "rules": {
    "EARTHQUAKE": "severity and radius exactly as intake-service: magnitude >= 6.5 CRITICAL, >= 5.5 HIGH, >= 4.5 MEDIUM, else LOW; radius = 15 km x 2^(M-3), max 500 km; centred on the epicentre",
    "FLOOD": "rain in 24 h: >= 204.5 mm CRITICAL, >= 115.6 HIGH, >= 64.5 MEDIUM (IMD bands, as intake-service); radius 25 km (intake-service weather radius)",
    "CYCLONE": "IMD 'super' or 'extremely severe' cyclonic storm at landfall: CRITICAL; radius 100 km around the landfall point",
    "INDUSTRIAL_ACCIDENT": "release over a city-wide area: CRITICAL; over a neighbourhood: HIGH; radius from the reported affected area (r = sqrt(area / pi))",
    "LANDSLIDE": "slope failure burying a settlement: HIGH; radius 1 km",
    "FIRE": "multi-storey building fire with mass casualties: HIGH; radius 0.5 km"
  },
